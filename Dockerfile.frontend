# 前端构建阶段：把 Vue/Vite 项目编译成 dist 静态文件。
FROM node:22-alpine AS builder

ARG NPM_REGISTRY=https://registry.npmmirror.com
# 2 核 2G 服务器还要承载多个服务，限制堆大小避免 Vite 构建挤占线上 API/sshd 内存。
# 前端构建应在 api/backend 保持可用时串行执行，构建堆不超过 512 MB。
ENV NODE_OPTIONS=--max-old-space-size=512

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm config set registry "${NPM_REGISTRY}" \
    && npm ci --ignore-scripts --legacy-peer-deps

COPY index.html ./
COPY vite.config.ts ./
COPY tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY env.d.ts ./
COPY postcss.config.js tailwind.config.js ./
COPY public ./public
COPY src ./src

# 生产环境走同域名 /api，由 Nginx 反向代理到 Node 后端。
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build-only

# 运行阶段：只保留 Nginx 和 dist，不把源码、node_modules 带进最终镜像。
FROM nginx:1.27-alpine AS runtime

RUN rm -f /etc/nginx/conf.d/default.conf \
    && addgroup -S app \
    && adduser -S -G app app \
    && mkdir -p /var/cache/nginx /var/run /var/log/nginx /tmp/client_temp /tmp/proxy_temp \
      /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp \
    && chown -R app:app /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html \
      /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp

COPY nginx-main.conf /etc/nginx/nginx.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

USER app
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
