# ProjectDream 生产部署环境变量示例。
# 使用时复制为 .env.production，并把所有“请替换”内容改成真实值。

# 服务器公网地址。必须填写视频模型实际可访问的入口（包含非 80/443 端口）。
# 当前开发机/云端验收入口为 http://<YOUR_SERVER_IP>:8002；有域名和 HTTPS 后改成 https://你的域名。
PUBLIC_BASE_URL=http://<YOUR_SERVER_IP>:8002
HTTP_PORT=8002

# Required in production: generate a private random value (for example, `openssl rand -hex 32`).
CAPTCHA_SECRET=

# Docker 构建加速。当前项目主要使用 npm；PIP_INDEX_URL 是按服务器习惯预留给 Python 工具的国内源。
NPM_REGISTRY=https://registry.npmmirror.com
APK_MIRROR=https://mirrors.aliyun.com/alpine
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# RAG sidecar: LlamaIndex + Milvus + Zhipu embedding-3. Keep all secrets out of Git.
RAG_APP_ENV=production
# 内网调用令牌；留空时 RAG 服务保持未就绪，正式部署前生成高强度随机值。
INTERNAL_TOKEN=
# Leave this local Lite path for a single-machine pilot, or replace it with a
# private Milvus/Zilliz URI for production. Do not expose Milvus to the public internet.
RAG_MILVUS_URI=/app/.codex-runtime/milvus/projectdream.db
RAG_MILVUS_TOKEN=
MILVUS_COLLECTION=projectdream_rag_v1
MILVUS_DIM=2048
ZHIPU_MODEL=embedding-3
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_DIMENSIONS=2048
# Node API -> RAG sidecar. Keep disabled until the sidecar has passed cloud readiness checks.
RAG_ENABLED=false
RAG_INDEX_ENABLED=false
RAG_SERVICE_URL=http://rag:8001
RAG_INTERNAL_TOKEN=
RAG_TIMEOUT_MS=15000
RAG_TOP_K=5

# 前端生产环境通过同域 /api 访问后端，由 Nginx 代理到 FastAPI gateway:8000。
VITE_API_BASE_URL=/api

# Object storage. Keep the COS bucket private; provider access uses short-lived signed URLs.
OBJECT_STORAGE_PROVIDER=cos
COS_SECRET_ID=请替换为COS子账号SecretId
COS_SECRET_KEY=请替换为COS子账号SecretKey
COS_BUCKET=请替换为存储桶名称-APPID
COS_REGION=ap-guangzhou
COS_DOMAIN=
COS_PROTOCOL=https:
OBJECT_STORAGE_PUBLIC_BASE_URL=https://请替换为存储桶名称-APPID.cos.ap-guangzhou.myqcloud.com
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900
REMOTE_MEDIA_ALLOWED_HOSTS=platform-outputs.agnes-ai.space,maas-watermark-prod-new.cn-wlcb.ufileos.com,aigc-files.bigmodel.cn
REMOTE_MEDIA_MAX_BYTES=134217728
REMOTE_MEDIA_DOWNLOAD_TIMEOUT_MS=180000
EXPIRED_VIDEO_RECOVERY_MAX_ATTEMPTS=3
# Runtime roles. Compose fixes worker-node to worker; the FastAPI api service is fixed to api.
BACKGROUND_QUEUE_POLL_INTERVAL_MS=15000
GENERATION_WORKER_CONCURRENCY=1
# Optional: set to 1 only for a controlled single-job Worker validation run.
GENERATION_WORKER_MAX_JOBS=
# Internal safety switch for a controlled Worker; use only via `npm run worker:recovery-once`.
GENERATION_WORKER_ONLY_JOB_ID=
GENERATION_JOB_MAX_ATTEMPTS=3
GENERATION_RETRY_BASE_DELAY_MS=5000
GENERATION_RETRY_MAX_DELAY_MS=300000

# MySQL。MYSQL_* 由 Compose 初始化数据库，后端会被注入对应 DB_* 配置。
MYSQL_DATABASE=projectdream
MYSQL_USER=projectdream
MYSQL_PASSWORD=请替换为业务数据库密码
MYSQL_ROOT_PASSWORD=请替换为Root数据库密码
MYSQL_TUNNEL_PORT=3306

# 短信服务。演示环境建议先用 mock，真实上线再切 aliyun 或 tencent。
SMS_PROVIDER=mock
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM={"code":"{{code}}","min":"{{validMinutes}}"}
ALIYUN_SMS_SCHEME_NAME=
ALIYUN_SMS_CODE_LENGTH=6
ALIYUN_SMS_CODE_TYPE=1
ALIYUN_SMS_DUPLICATE_POLICY=1
ALIYUN_SMS_INTERVAL=60
ALIYUN_SMS_VALID_TIME=300
ALIYUN_DYPNS_SUBSCRIPTION_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SMS_REGION=ap-guangzhou
TENCENTCLOUD_SMS_SDK_APP_ID=
TENCENTCLOUD_SMS_SIGN_NAME=
TENCENTCLOUD_SMS_TEMPLATE_ID=

# 文本模型：总纲、剧本、角色、分镜。
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://huoshenai.com/v1
AI_API_KEY=请替换为文本模型API密钥
AI_MODEL=gpt-5.4
AI_MODEL_OUTLINE=gpt-5.4
AI_MODEL_SCRIPT=gpt-5.4
AI_MODEL_STORYBOARD=gpt-5.4
AI_MODEL_CHARACTER=gpt-5.4
AI_TIMEOUT_MS=60000
AI_FALLBACK_TO_MOCK=true

# 图片和源图上传。火山方舟示例：
# FRAME_PROVIDER=volcengine
# FRAME_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# FRAME_MODEL=doubao-seedream-4-5-251128
TOAPI_API_KEY=请替换为ToAPI密钥
FRAME_PROVIDER=agnes
FRAME_BASE_URL=https://apihub.agnes-ai.com/v1
FRAME_IMAGE_SIZE=2K
FRAME_IMAGE_RATIO=16:9
FRAME_MODEL=agnes-image-2.1-flash
FRAME_FALLBACK_MODELS=agnes-image-2.0-flash
FRAME_WATERMARK_ENABLED=false
FRAME_TIMEOUT_MS=180000
FRAME_RETRY_ATTEMPTS=2
FRAME_RETRY_BASE_DELAY_MS=5000
FRAME_POLL_INTERVAL_MS=6000
FRAME_POLL_TIMEOUT_MS=180000
FRAME_FALLBACK_TO_MOCK=false

# 视频生成。
BIGMODEL_API_KEY=请替换为智谱或视频模型密钥
AGNES_API_KEY=请替换为Agnes密钥
# Wan 3.0（VIDEO_PROVIDER=wan）：原生异步接口
# {VIDEO_BASE_URL}/api/v1/services/aigc/video-generation/video-synthesis
# VIDEO_BASE_URL 可为 DashScope 主机或 Workspace 主机（含/不含 /compatible-mode/v1）。
WAN_API_BASE_URL=
WAN_API_KEY=
# 环境变量优先于数据库模型设置，逗号分隔；Wan 测试建议：
# VIDEO_PROVIDER,VIDEO_BASE_URL,VIDEO_API_KEY,VIDEO_MODEL,VIDEO_SIZE
MODEL_SETTINGS_ENV_OVERRIDES=
VIDEO_PROVIDER=bigmodel
VIDEO_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VIDEO_MODEL=cogvideox-flash
VIDEO_SIZE=1920x1080
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FRAME_RATE=30
VIDEO_QUALITY=speed
VIDEO_WITH_AUDIO=false
VIDEO_WATERMARK_ENABLED=false
VIDEO_REQUEST_TIMEOUT_MS=60000
VIDEO_CREATE_RETRY_ATTEMPTS=2
VIDEO_CREATE_RETRY_BASE_DELAY_MS=5000
VIDEO_CREATE_RATE_LIMIT_DELAY_MS=60000
VIDEO_CREATE_RATE_LIMIT_MAX_REQUESTS=2
VIDEO_CREATE_RATE_LIMIT_WINDOW_MS=60000
VIDEO_REFERENCE_IMAGE_SIGNED_URL_TTL_SECONDS=3600
VIDEO_POLL_INTERVAL_MS=10000
VIDEO_POLL_TIMEOUT_MS=1200000
VIDEO_FALLBACK_TO_MOCK=false
VIDEO_IMAGE_UPLOAD_BASE_URL=https://toapis.com/v1
VIDEO_IMAGE_UPLOAD_API_KEY=请替换为源图上传密钥
VIDEO_IMAGE_UPLOAD_TIMEOUT_MS=120000
VIDEO_IMAGE_UPLOAD_RETRY_ATTEMPTS=2
VIDEO_IMAGE_UPLOAD_RETRY_BASE_DELAY_MS=1500
VIDEO_REFERENCE_AUDIO_SIGNED_URL_TTL_SECONDS=3600

# 口型同步。
LIP_SYNC_PROVIDER=dashscope
LIP_SYNC_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LIP_SYNC_API_KEY=请替换为DashScope密钥
LIP_SYNC_MODEL=videoretalk
LIP_SYNC_RESOLUTION=720p
LIP_SYNC_ASPECT_RATIO=16:9
LIP_SYNC_GENERATE_AUDIO=true
LIP_SYNC_INFERENCE_STEPS=20
LIP_SYNC_GUIDANCE_SCALE=1.5
LIP_SYNC_SEED=
LIP_SYNC_REQUEST_TIMEOUT_MS=120000
LIP_SYNC_POLL_INTERVAL_MS=5000
LIP_SYNC_POLL_TIMEOUT_MS=1800000

# 语音合成。
DASHSCOPE_API_KEY=请替换为DashScope密钥
AUDIO_PROVIDER=dashscope
AUDIO_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
AUDIO_MODEL=qwen3-tts-flash
AUDIO_FALLBACK_MODEL=qwen3-tts-instruct-flash
AUDIO_VOICE_DESIGN_MODEL=cosyvoice-v3.5-flash
AUDIO_VOICE=Cherry
AUDIO_LANGUAGE_TYPE=Chinese
AUDIO_MAX_TEXT_LENGTH=600
AUDIO_TIMEOUT_MS=120000
AUDIO_RETRY_ATTEMPTS=2
AUDIO_RETRY_BASE_DELAY_MS=3000
AUDIO_FALLBACK_TO_MOCK=false
